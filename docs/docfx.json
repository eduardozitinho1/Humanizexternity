{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/H13y/H13y.csproj"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/*.yml",
          "*.md",
          "articles/*.md",
          "toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "favicon.svg",
          "logo.svg"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Humanizexternity",
      "_appTitle": "Humanizexternity — Documentation",
      "_appLogoPath": "logo.svg",
      "_appFaviconPath": "favicon.svg",
      "_appFooter": "Humanizexternity · MIT · <a href=\"https://eduardoweb.us.ci\">Eduardo Amorim Pereira</a>",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/eduardozitinho1/Humanizexternity",
        "branch": "main"
      },
      "_lang": "en-US"
    }
  }
}
