<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>H13y</RootNamespace>
    <AssemblyName>H13y</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>Humanizexternity</PackageId>
    <Version>1.3.0</Version>
    <Authors>Eduardo Zitinho</Authors>
    <Description>Humanize any measure. 1024 MB to 1 GB. 1500 g to 1.5 kg. 3661 s to 1 h 1 min 1 s.</Description>
    <PackageTags>humanize;units;measures;bytes;mass;length;time;format</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/eduardozitinho1/Humanizexternity</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
